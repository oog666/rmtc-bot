# RMTC 参赛镜像（提交版）：代码 + 已构建工作空间 + 启动脚本，单镜像即可独立运行
#
# 与 docker/Dockerfile 的区别：
#   docker/Dockerfile        只装环境，代码在运行时挂载（日常开发/联调用）
#   docker/Dockerfile.submit 把代码 COPY 进镜像并预先 colcon build（提交/检录用）
#
# 构建（必须在仓库根目录，context = 仓库根）：
#   docker build -f docker/Dockerfile.submit -t rmtc/contestant:v1.1 .
# 或直接用脚本（含冒烟测试、导出、校验和）：
#   ./docker/make_submit_image.sh
#
# 运行：
#   docker run --rm --network host -e ROS_DOMAIN_ID=27 \
#     -e RMTC_TEAM_TOKEN='本场令牌' -e RMTC_AI_URL='http://127.0.0.1:8080/v1/chat/completions' \
#     rmtc/contestant:v1.1 /ws/run_contestant.sh A '队名'

ARG BASE_IMAGE=ros:humble-ros-base
FROM ${BASE_IMAGE}

# 可选：国内 apt / ROS 源（默认不改）
ARG APT_MIRROR=
ARG ROS_MIRROR=

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=humble \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp \
    ROS_LOCALHOST_ONLY=0 \
    RMTC_DECISION_CONFIG=/ws/decision_config.json

RUN set -eux; \
    if [ -n "${APT_MIRROR}" ] && [ -f /etc/apt/sources.list ]; then \
      sed -i "s|http://archive.ubuntu.com/ubuntu|http://${APT_MIRROR}/ubuntu|g; \
              s|http://security.ubuntu.com/ubuntu|http://${APT_MIRROR}/ubuntu|g" \
             /etc/apt/sources.list || true; \
    fi; \
    if [ -n "${ROS_MIRROR}" ] && [ -f /etc/apt/sources.list.d/ros2.list ]; then \
      sed -i "s|http://packages.ros.org/ros2/ubuntu|${ROS_MIRROR}|g" \
             /etc/apt/sources.list.d/ros2.list || true; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
      python3-colcon-common-extensions \
      python3-requests \
      ros-humble-rmw-fastrtps-cpp \
      ros-humble-statistics-msgs \
      ros-humble-libstatistics-collector \
      iproute2 iputils-ping net-tools procps ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ws

# 只拷贝运行所需内容（不含 build/install/log、实验输出、缓存）
COPY contestant_ws/src /ws/contestant_ws/src
COPY tools /ws/tools
COPY decision_config.json run_contestant.sh start_bot.sh README.md /ws/

# 预先构建：镜像启动即用，现场不需要 colcon build
RUN set -eux; \
    . /opt/ros/humble/setup.sh; \
    cd /ws/contestant_ws; \
    colcon build --symlink-install --packages-select rmtc_bot; \
    . /ws/contestant_ws/install/setup.bash; \
    ros2 pkg prefix rmtc_bot

RUN chmod +x /ws/run_contestant.sh /ws/start_bot.sh

LABEL org.opencontainers.image.title="RMTC contestant" \
      org.opencontainers.image.version="1.1" \
      org.opencontainers.image.description="ROS 2 Humble autonomous contestant build for RMTC Turing Challenge"

# 默认直接起比赛端（席位/队名用默认值，正式上场用命令行覆盖）
CMD ["bash", "-lc", "source /opt/ros/humble/setup.bash && source /ws/contestant_ws/install/setup.bash && exec /ws/run_contestant.sh A contestant"]
